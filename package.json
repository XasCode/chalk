{
	"name": "@xascode/chalk",
	"version": "0.1.4",
	"description": "Terminal string styling done right",
	"license": "MIT",
	"repository": "XasCode/chalk",
	"funding": "https://github.com/chalk/chalk?sponsor=1",
	"type": "module",
	"main": "./dist/index.cjs",
	"exports": {
		"types": "./dist/source/index.d.ts",
		"import": "./dist/chalk.js",
		"require": "./dist/index.cjs"
	},
	"imports": {
		"#ansi-styles": "./source/vendor/ansi-styles/index.js",
		"#supports-color": {
			"node": "./source/vendor/supports-color/index.js",
			"default": "./source/vendor/supports-color/browser.js"
		}
	},
	"sideEffects": false,
	"types": "./dist/source/index.d.ts",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "vitest run --coverage --reporter dot && npm run test:package",
		"test:package": "npm run build && node --test __tests__/package-smoke.mjs",
		"bench": "node benchmark.js",
		"commit": "commit",
		"build": "tsc && vite build",
		"lint": "eslint source --max-warnings 0",
		"prepare": "husky"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"MIGRATION.md"
	],
	"keywords": [
		"color",
		"colour",
		"colors",
		"terminal",
		"console",
		"cli",
		"string",
		"ansi",
		"style",
		"styles",
		"tty",
		"formatting",
		"rgb",
		"256",
		"shell",
		"xterm",
		"log",
		"logging",
		"command-line",
		"text"
	],
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@commitlint/prompt-cli": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@microsoft/eslint-formatter-sarif": "^3.1.0",
		"@types/node": "^22.20.5",
		"@vitest/coverage-istanbul": "^5.0.3",
		"ansi-styles": "^7.0.0",
		"builtin-modules": "^5.4.0",
		"color-convert": "^3.1.3",
		"eslint": "^10.12.0",
		"execa": "^10.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"log-update": "^8.0.0",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"yoctodelay": "^2.0.0"
	}
}